FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build

WORKDIR /src

COPY ["CloudflareFastCDN.csproj", "./"]
RUN dotnet restore "CloudflareFastCDN.csproj"

COPY . .
RUN dotnet publish "CloudflareFastCDN.csproj" -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/runtime:9.0 AS runtime

WORKDIR /app

COPY --from=build /app/publish .

RUN mkdir -p /data

ARG CLOUDFLARE_KEY=""
ARG TENCENTCLOUD_SECRET_ID=""
ARG TENCENTCLOUD_SECRET_KEY=""
ARG ALIBABACLOUD_ACCESS_KEY_ID=""
ARG ALIBABACLOUD_ACCESS_KEY_SECRET=""
ARG CLOUDFLARE_DOMAINS=""
ARG CLOUDFLARE_DOMAINS2=""
ARG CLOUDFLARE_DOMAINS3=""
ARG TENCENTCLOUD_DOMAINS=""
ARG TENCENTCLOUD_DOMAINS2=""
ARG TENCENTCLOUD_DOMAINS3=""
ARG ALIBABACLOUD_DOMAINS=""
ARG ALIBABACLOUD_DOMAINS2=""
ARG ALIBABACLOUD_DOMAINS3=""
ARG PING_THREADS="8"
ARG MAX_IPS="400"
ARG PING_INTERVAL_MS="150"
ARG HTTP_PROBE_URL="https://www.visa.cn/"
ARG HTTP_PROBE_TIMEOUT_MS="4000"
ARG HTTP_SPEEDTEST_TIMEOUT_MS="10000"
ARG HTTP_SPEEDTEST_IDLE_TIMEOUT_MS="3000"
ARG RUN_MINUTES="60"
ARG BANDWIDTH_PRIORITY="false"
ARG UPDATE_IP_LIST="false"
ARG ENABLE_SUPPLEMENTAL_HTTP_CHECK="false"

ENV CLOUDFLARE_KEY=${CLOUDFLARE_KEY} \
    TENCENTCLOUD_SECRET_ID=${TENCENTCLOUD_SECRET_ID} \
    TENCENTCLOUD_SECRET_KEY=${TENCENTCLOUD_SECRET_KEY} \
    ALIBABACLOUD_ACCESS_KEY_ID=${ALIBABACLOUD_ACCESS_KEY_ID} \
    ALIBABACLOUD_ACCESS_KEY_SECRET=${ALIBABACLOUD_ACCESS_KEY_SECRET} \
    CLOUDFLARE_DOMAINS=${CLOUDFLARE_DOMAINS} \
    CLOUDFLARE_DOMAINS2=${CLOUDFLARE_DOMAINS2} \
    CLOUDFLARE_DOMAINS3=${CLOUDFLARE_DOMAINS3} \
    TENCENTCLOUD_DOMAINS=${TENCENTCLOUD_DOMAINS} \
    TENCENTCLOUD_DOMAINS2=${TENCENTCLOUD_DOMAINS2} \
    TENCENTCLOUD_DOMAINS3=${TENCENTCLOUD_DOMAINS3} \
    ALIBABACLOUD_DOMAINS=${ALIBABACLOUD_DOMAINS} \
    ALIBABACLOUD_DOMAINS2=${ALIBABACLOUD_DOMAINS2} \
    ALIBABACLOUD_DOMAINS3=${ALIBABACLOUD_DOMAINS3} \
    PING_THREADS=${PING_THREADS} \
    MAX_IPS=${MAX_IPS} \
    PING_INTERVAL_MS=${PING_INTERVAL_MS} \
    HTTP_PROBE_URL=${HTTP_PROBE_URL} \
    HTTP_PROBE_TIMEOUT_MS=${HTTP_PROBE_TIMEOUT_MS} \
    HTTP_SPEEDTEST_TIMEOUT_MS=${HTTP_SPEEDTEST_TIMEOUT_MS} \
    HTTP_SPEEDTEST_IDLE_TIMEOUT_MS=${HTTP_SPEEDTEST_IDLE_TIMEOUT_MS} \
    RUN_MINUTES=${RUN_MINUTES} \
    BANDWIDTH_PRIORITY=${BANDWIDTH_PRIORITY} \
    UPDATE_IP_LIST=${UPDATE_IP_LIST} \
    ENABLE_SUPPLEMENTAL_HTTP_CHECK=${ENABLE_SUPPLEMENTAL_HTTP_CHECK}

ENTRYPOINT ["dotnet", "CloudflareFastCDN.dll"]

VOLUME ["/data"]
