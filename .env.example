# GHCR 镜像地址，不包含版本标签
IMAGE_NAME=ghcr.io/aiqinxuancai/cloudflarefastcdn

# 镜像版本标签；生产环境建议填写固定版本，例如 v1.0.7
IMAGE_TAG=latest

# 容器时区，用于控制日志时间
TZ=Asia/Shanghai

# Web 管理页面端口；设置为 0 关闭管理页面（关闭后只能通过环境变量配置）
WEB_PORT=19401

# ---------------------------------------------------------------------------
# 以下运行设置推荐在 Web 管理页面中配置（保存在数据卷的 settings.json 中）。
# 取消注释并填写后，对应项目将以环境变量为准，并在 Web 页面中锁定为只读。
# 多个域名使用英文逗号分隔。
# ---------------------------------------------------------------------------

# Cloudflare API Token，需要具有 DNS 编辑权限
# CLOUDFLARE_KEY=

# 使用优选第 1 名 IP 更新的 Cloudflare 域名
# CLOUDFLARE_DOMAINS=

# 使用优选第 2 名 IP 更新的 Cloudflare 域名
# CLOUDFLARE_DOMAINS2=

# 使用优选第 3 名 IP 更新的 Cloudflare 域名
# CLOUDFLARE_DOMAINS3=

# 腾讯云 API SecretId
# TENCENTCLOUD_SECRET_ID=

# 腾讯云 API SecretKey
# TENCENTCLOUD_SECRET_KEY=

# 使用优选第 1 名 IP 更新的腾讯云 DNSPod 域名
# TENCENTCLOUD_DOMAINS=

# 使用优选第 2 名 IP 更新的腾讯云 DNSPod 域名
# TENCENTCLOUD_DOMAINS2=

# 使用优选第 3 名 IP 更新的腾讯云 DNSPod 域名
# TENCENTCLOUD_DOMAINS3=

# 阿里云 API AccessKey ID
# ALIBABACLOUD_ACCESS_KEY_ID=

# 阿里云 API AccessKey Secret
# ALIBABACLOUD_ACCESS_KEY_SECRET=

# 使用优选第 1 名 IP 更新的阿里云解析域名
# ALIBABACLOUD_DOMAINS=

# 使用优选第 2 名 IP 更新的阿里云解析域名
# ALIBABACLOUD_DOMAINS2=

# 使用优选第 3 名 IP 更新的阿里云解析域名
# ALIBABACLOUD_DOMAINS3=

# Ping 检测并发线程数
# PING_THREADS=8

# 每轮最多抽样的 IP 数量
# MAX_IPS=400

# 单次 Ping 的间隔时间，单位为毫秒
# PING_INTERVAL_MS=150

# HTTP 连通性验证地址，建议使用已开启 Cloudflare 代理的自有站点
# HTTP_PROBE_URL=https://www.visa.cn/

# HTTP 验证和测速请求附加的请求头；多个请求头使用英文分号分隔，格式为 Header-Name:Value;Another-Header:Value
# HTTP_PROBE_HEADERS=

# 单次 HTTP 连通性验证超时时间，单位为毫秒
# HTTP_PROBE_TIMEOUT_MS=4000

# HTTP 带宽测速总超时时间，单位为毫秒
# HTTP_SPEEDTEST_TIMEOUT_MS=10000

# HTTP 带宽测速读取空闲超时时间，单位为毫秒
# HTTP_SPEEDTEST_IDLE_TIMEOUT_MS=3000

# 每轮任务完成后的等待时间，单位为分钟
# RUN_MINUTES=60

# 是否启用带宽优先模式；true 表示下载 /speedtest 测速，失败时回退到延迟优选
# BANDWIDTH_PRIORITY=false

# 是否在启动时更新 Cloudflare 官方 IPv4 网段列表
# UPDATE_IP_LIST=false

# 是否在等待期间每 5 分钟验证当前最优 IP；连续 3 次失败将提前重新优选
# ENABLE_SUPPLEMENTAL_HTTP_CHECK=false

# 是否跳过首次域名 IP 预检并强制执行全量优选
# FORCE_INITIAL_FULL_SELECTION=false

# Web 管理页面登录用户名
# WEB_USERNAME=admin

# Web 管理页面登录密码；留空则无需登录，暴露到公网时务必设置
# WEB_PASSWORD=
